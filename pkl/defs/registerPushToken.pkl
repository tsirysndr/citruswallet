lexicon = 1
id = "app.citruswallet.registerPushToken"
defs = new Dynamic {
  `main` = new Dynamic {
    `type` = "procedure"
    `input` = new Dynamic {
      `encoding` = "application/json"
      `schema` = new Dynamic {
        `type` = "object"
        `required` = List("token", "platform")
        `properties` = new Dynamic {
          `token` = new Dynamic {
            `type` = "string"
            `maxLength` = 256
          }
          `platform` = new Dynamic {
            `type` = "string"
            `enum` = List("android", "ios")
          }
        }
      }
    }
    `output` = new Dynamic {
      `encoding` = "application/json"
      `schema` = new Dynamic {
        `type` = "object"
        `required` = List("ok")
        `properties` = new Dynamic {
          `ok` = new Dynamic {
            `type` = "boolean"
          }
        }
      }
    }
  }
}
