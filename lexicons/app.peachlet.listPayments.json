{
  "lexicon": 1,
  "id": "app.peachlet.listPayments",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 512
          },
          "direction": {
            "type": "string",
            "enum": [
              "all",
              "sent",
              "received"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "all",
              "waiting",
              "ready",
              "prepared",
              "submitted",
              "confirming",
              "confirmed",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "after": {
            "type": "string",
            "maxLength": 15,
            "description": "Inclusive Unix timestamp in milliseconds, encoded as a decimal string."
          },
          "before": {
            "type": "string",
            "maxLength": 15,
            "description": "Inclusive Unix timestamp in milliseconds, encoded as a decimal string."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "sort": {
            "type": "string",
            "enum": [
              "newest",
              "oldest"
            ]
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "payments",
            "total",
            "page",
            "pageSize"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "page": {
              "type": "integer"
            },
            "pageSize": {
              "type": "integer"
            },
            "payments": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.peachlet.defs#payment"
              }
            }
          }
        }
      }
    }
  }
}
