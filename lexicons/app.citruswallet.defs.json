{
  "lexicon": 1,
  "id": "app.citruswallet.defs",
  "defs": {
    "actor": {
      "type": "object",
      "required": [
        "did",
        "handle",
        "displayName",
        "avatar"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      },
      "nullable": [
        "displayName",
        "avatar"
      ]
    },
    "currency": {
      "type": "object",
      "required": [
        "name",
        "symbol",
        "decimals"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "decimals": {
          "type": "integer"
        }
      }
    },
    "network": {
      "type": "object",
      "required": [
        "chainId",
        "chainIdHex",
        "name",
        "nativeCurrency"
      ],
      "properties": {
        "chainId": {
          "type": "integer"
        },
        "chainIdHex": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nativeCurrency": {
          "type": "ref",
          "ref": "app.citruswallet.defs#currency"
        },
        "rpcUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "did",
        "address",
        "chain_id",
        "message",
        "signature",
        "linked_at",
        "public",
        "is_default"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "chain_id": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "linked_at": {
          "type": "string"
        },
        "public": {
          "type": "boolean"
        },
        "is_default": {
          "type": "boolean"
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "network",
        "paymentsEnabled",
        "did",
        "csrf",
        "links",
        "addressSyncPending"
      ],
      "properties": {
        "network": {
          "type": "ref",
          "ref": "app.citruswallet.defs#network"
        },
        "paymentsEnabled": {
          "type": "boolean"
        },
        "did": {
          "type": "string"
        },
        "csrf": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "app.citruswallet.defs#link"
          }
        },
        "addressSyncPending": {
          "type": "boolean"
        }
      },
      "nullable": [
        "did"
      ]
    },
    "paymentState": {
      "type": "string",
      "knownValues": [
        "waiting",
        "ready",
        "prepared",
        "submitted",
        "confirming",
        "confirmed",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "chain",
        "chainId",
        "kind",
        "contractAddress",
        "symbol",
        "name",
        "decimals"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "chain": {
          "type": "string"
        },
        "chainId": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "native",
            "erc20"
          ]
        },
        "contractAddress": {
          "type": "string"
        },
        "symbol": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "nullable": [
        "contractAddress"
      ]
    },
    "assetBalance": {
      "type": "object",
      "required": [
        "asset",
        "balanceAtomic",
        "address"
      ],
      "properties": {
        "asset": {
          "type": "ref",
          "ref": "app.citruswallet.defs#asset"
        },
        "balanceAtomic": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "payment": {
      "type": "object",
      "required": [
        "id",
        "senderDid",
        "recipientDid",
        "recipientLabel",
        "chainId",
        "asset",
        "amount",
        "amountWei",
        "state",
        "address",
        "revision",
        "source",
        "createdAt",
        "expiresAt",
        "txHash",
        "error",
        "confirmationsRequired"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "senderDid": {
          "type": "string"
        },
        "recipientDid": {
          "type": "string"
        },
        "recipientLabel": {
          "type": "string"
        },
        "chainId": {
          "type": "integer"
        },
        "asset": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "media": {
          "type": "ref",
          "ref": "app.citruswallet.defs#paymentMedia"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "maxGraphemes": 500
        },
        "sender": {
          "type": "ref",
          "ref": "app.citruswallet.defs#actor"
        },
        "recipient": {
          "type": "ref",
          "ref": "app.citruswallet.defs#actor"
        },
        "assetId": {
          "type": "string"
        },
        "assetDetails": {
          "type": "ref",
          "ref": "app.citruswallet.defs#asset"
        },
        "amountAtomic": {
          "type": "string"
        },
        "amountWei": {
          "type": "string"
        },
        "state": {
          "type": "ref",
          "ref": "app.citruswallet.defs#paymentState"
        },
        "address": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "txHash": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "confirmationsRequired": {
          "type": "integer"
        },
        "attemptId": {
          "type": "string"
        },
        "fromAddress": {
          "type": "string"
        },
        "nonce": {
          "type": "integer"
        }
      },
      "nullable": [
        "address",
        "txHash",
        "error",
        "attemptId",
        "fromAddress",
        "nonce",
        "description",
        "media",
        "sender",
        "recipient"
      ]
    },
    "transaction": {
      "type": "object",
      "required": [
        "from",
        "to",
        "value",
        "chainId",
        "nonce",
        "data"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "chainId": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "payment",
        "attemptId",
        "transaction"
      ],
      "properties": {
        "payment": {
          "type": "ref",
          "ref": "app.citruswallet.defs#payment"
        },
        "attemptId": {
          "type": "string"
        },
        "transaction": {
          "type": "ref",
          "ref": "app.citruswallet.defs#transaction"
        }
      }
    },
    "recipient": {
      "type": "object",
      "required": [
        "did",
        "handle",
        "chainId",
        "address"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "chainId": {
          "type": "integer"
        },
        "address": {
          "type": "string"
        }
      },
      "nullable": [
        "handle",
        "address"
      ]
    },
    "challenge": {
      "type": "object",
      "required": [
        "id",
        "address",
        "chainId",
        "message",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "chainId": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        }
      }
    },
    "linksResult": {
      "type": "object",
      "required": [
        "links"
      ],
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "app.citruswallet.defs#link"
          }
        },
        "addressSyncPending": {
          "type": "boolean"
        }
      }
    },
    "paymentResult": {
      "type": "object",
      "required": [
        "payment"
      ],
      "properties": {
        "payment": {
          "type": "ref",
          "ref": "app.citruswallet.defs#payment"
        }
      }
    },
    "invitationResult": {
      "type": "object",
      "required": [
        "invitationUrl"
      ],
      "properties": {
        "invitationUrl": {
          "type": "string"
        }
      }
    },
    "paymentMedia": {
      "type": "object",
      "required": [
        "kind",
        "slug",
        "url",
        "preview",
        "title"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gifs",
            "stickers",
            "static-memes",
            "clips"
          ]
        },
        "slug": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "preview": {
          "type": "string",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
