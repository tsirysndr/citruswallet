{
  "lexicon": 1,
  "id": "app.peachlet.acceptInvitation",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "token",
            "address"
          ],
          "properties": {
            "token": {
              "type": "string",
              "maxLength": 128
            },
            "address": {
              "type": "string",
              "maxLength": 42
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "app.peachlet.defs#paymentResult"
        }
      }
    }
  }
}
