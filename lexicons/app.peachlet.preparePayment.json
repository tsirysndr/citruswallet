{
  "lexicon": 1,
  "id": "app.peachlet.preparePayment",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "address",
            "fromAddress"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "address": {
              "type": "string",
              "maxLength": 42
            },
            "fromAddress": {
              "type": "string",
              "maxLength": 42
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "app.peachlet.defs#attempt"
        }
      }
    }
  }
}
