{
  "lexicon": 1,
  "id": "app.peachlet.listNotifications",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "notifications",
            "unread"
          ],
          "properties": {
            "notifications": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#notification"
              }
            },
            "unread": {
              "type": "integer"
            }
          }
        }
      }
    },
    "notification": {
      "type": "object",
      "required": [
        "id",
        "paymentId",
        "kind",
        "createdAt",
        "read"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "paymentId": {
          "type": "string",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "maxLength": 64,
          "knownValues": [
            "payment_received",
            "recipient_ready"
          ]
        },
        "read": {
          "type": "boolean"
        }
      }
    }
  }
}
