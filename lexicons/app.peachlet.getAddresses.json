{
  "lexicon": 1,
  "id": "app.peachlet.getAddresses",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "did",
            "links"
          ],
          "properties": {
            "did": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.peachlet.defs#link"
              }
            }
          }
        }
      }
    }
  }
}
