{
  "lexicon": 1,
  "id": "app.citruswallet.exchangeNativeSession",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "code",
            "verifier"
          ],
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 64
            },
            "verifier": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
