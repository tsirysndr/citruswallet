{
  "name": "peachlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peachlet — self-custody EVM payments with AT Protocol identity",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "gleam run",
    "dev:web": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build && gleam build",
    "start": "gleam run",
    "check": "gleam check && tsc -p web",
    "format": "prettier --write web app",
    "format:check": "prettier --check web app",
    "test": "gleam test && node --test test/*.test.mjs && bun run test:web",
    "db:generate": "gleam build && drizzle-kit generate",
    "db:check": "gleam build && drizzle-kit check",
    "anvil": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "lex:generate": "node scripts/lexicons.mjs",
    "test:web": "vitest run",
    "test:web:watch": "vitest"
  },
  "dependencies": {
    "@atproto/identity": "^0.5.20",
    "@atproto/lexicon": "0.4.14",
    "@atproto/oauth-client": "0.8.10",
    "@atproto/oauth-client-node": "^0.5.12",
    "@atproto/syntax": "^0.7.7",
    "@atproto/xrpc": "0.7.7",
    "@peachlet/amounts": "file:app/packages/amounts",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^6.0.0",
    "@metamask/connect-evm": "^2.1.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jotai": "^3.0.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "viem": "^2.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "@peachlet/wallet-core": "file:app/packages/wallet-core"
  },
  "devDependencies": {
    "@atproto/lex-cli": "0.5.7",
    "@foundry-rs/anvil": "^1.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
