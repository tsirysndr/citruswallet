# Node 24+ and Gleam 1.19+. Defaults work without an .env file.
APP_URL=http://127.0.0.1:4747
PORT=4747
HOST=127.0.0.1
DATABASE_PATH=./data/wallet.sqlite
# Drizzle migrations applied at startup, and the built frontend directory.
MIGRATIONS_DIR=./drizzle
PUBLIC_DIR=./web/dist
# For a hosted HTTPS server, configure APP_URL to its public origin.
# Set TRUST_PROXY_HOPS only behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0
# 1 = Ethereum mainnet (default); 31337 = Anvil, allowed only with loopback APP_URL.
# bun run dev:local sets 31337 and uses data/local.sqlite automatically.
EVM_CHAIN_ID=1
# Server-side RPC for transaction verification. Required to send on mainnet.
# Anvil uses http://127.0.0.1:8545 automatically; dev:local overrides this value.
# ETH_RPC_URL=https://your-mainnet-rpc.example

# Frontend development server. VITE_API_URL is where it proxies /xrpc and /auth,
# so its port must match PORT above. Browse the dev server on 127.0.0.1, not
# localhost: AT Protocol OAuth rejects a "localhost" redirect URI (RFC 8252).
VITE_API_URL=http://localhost:4747
VITE_PORT=5173

# Concurrent production Jetstream listeners. Override the complete list with CSV.
# JETSTREAM_URLS=wss://jetstream1.us-east.bsky.network/subscribe,wss://jetstream2.us-west.bsky.network/subscribe
# Set false for offline/local development.
# JETSTREAM_ENABLED=false

# Public browser key for the optional KLIPY media picker (also read from .env.prod).
VITE_KLIPY_API_KEY=

# Optional push delivery settings. VAPID keys otherwise persist in the database.
# EXPO_ACCESS_TOKEN=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
